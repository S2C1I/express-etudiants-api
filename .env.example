# Copy to .env and fill values for local/dev or hosting platform env settings

# Web server
PORT=3000
# FRONTEND_ORIGIN can be a single origin, a comma-separated list, or "*" to allow any (no credentials in that case)
FRONTEND_ORIGIN=http://localhost:4200

# JWT secret for auth tokens
JWT_SECRET=change_me_to_a_long_random_string

# MongoDB connection
# For MongoDB Atlas, use the connection string from Atlas (replace <username>, <password>, and host)
# Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=
